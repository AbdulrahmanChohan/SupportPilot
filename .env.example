# =====================================================================
# SupportPilot — Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to version control.
# =====================================================================

# Azure AI Foundry Configuration
AZURE_AI_ENDPOINT=https://your-resource-name.services.ai.azure.com/openai/v1/responses
AZURE_AI_KEY=your-azure-ai-foundry-api-key-here
AZURE_MODEL_NAME=gpt-5-mini

# Retrieval & Generation Hyperparameters
MAX_OUTPUT_TOKENS=180
RETRIEVAL_TOP_K=3
SIMILARITY_THRESHOLD=0.40
RRF_K=60

# Operational Modes
RUN_LIVE_EVALUATION=false
MOCK_MODE=false

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
